              "pm.test(\"Status code là 200\", () => { pm.response.to.have.status(200); });",
              "pm.test(\"Response đúng cấu trúc đã thiết kế\", () => { const json = pm.response.json(); pm.expect(json).to.have.property('success', true); pm.expect(json.data).to.have.property('status', 'cancelled'); pm.expect(json.data._links).not.to.have.property('cancel'); });"
            ]
